generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model post_tags {
  post_id    BigInt   @db.UnsignedBigInt
  tags_id    BigInt   @db.UnsignedBigInt
  created_at DateTime @default(now()) @db.DateTime(0)
  posts      posts    @relation(fields: [post_id], references: [id], onDelete: Cascade, map: "fk_post_tags_post")
  tags       tags     @relation(fields: [tags_id], references: [id], onDelete: Cascade, map: "fk_post_tags_tag")

  @@id([post_id, tags_id])
  @@index([tags_id], map: "idx_post_tags_tags_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model posts {
  id           BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  title        String            @db.VarChar(255)
  slug         String            @unique(map: "uk_posts_slug") @db.VarChar(255)
  summary      String?           @db.Text
  content      String            @db.LongText
  post_status  posts_post_status @default(draft)
  cover_image  String?           @db.VarChar(500)
  published_at DateTime?         @db.DateTime(0)
  created_at   DateTime          @default(now()) @db.DateTime(0)
  updated_at   DateTime          @default(now()) @db.DateTime(0)
  post_tags    post_tags[]

  @@index([created_at], map: "idx_posts_created_at")
  @@index([published_at], map: "idx_posts_published_at")
  @@index([post_status], map: "idx_posts_status")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tags {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name       String      @unique(map: "uk_tags_name") @db.VarChar(100)
  slug       String      @unique(map: "uk_tags_slug") @db.VarChar(100)
  created_at DateTime    @default(now()) @db.DateTime(0)
  post_tags  post_tags[]
}

enum posts_post_status {
  draft
  published
  hidden
}
